p_mean = ds_control['lev'].values*100

lat = ds_control['lat'].values

I = (lat < 30) & (lat > -30)

area = ds_control['area'].values

area = area.reshape((1,len(area),1))

def tropical_average(var):
    var_mean = np.mean(var[:,I,:]*area[:,I,:],(0,1))/np.mean(area[:,I,:],(0,1))
    return var_mean

def in_cloud_average(var,count):
    var_copy = var.copy()
    #var_copy[count==0.0] = 0.0 
    var_mean = np.nanmean(var_copy[:,I,:]*area[:,I,:]*count[:,I,:],(0,1))/np.mean(area[:,I,:],(0,1))
    return var_mean

def in_cloud_sum(var,count):
    var_copy = var.copy()
    var_copy[np.isnan(var_copy)] = 0.0
    #var_mean = np.sum(var_copy[:,I,:]*area[:,I,:]*count[:,I,:],(0,1))/np.sum(area[:,I,:],(0,1))/len(var_copy[0,:,0])
    var_mean = np.mean(np.sum(count[:,I,:]*area[:,I,:]*var_copy[:,I,:],1)/np.sum(area[:,I,:],(0,1)),0)
    return var_mean

def get_vars(ds,ds_mass_flux):

    T = tropical_average(ds['T_mid'].values)

    p = (ds['p_mid'].values)

    
    count_ice = ds['count_where_qi_plus_qc_gt_0.00001'].values

    flux_sw_cs = (ds['SW_clrsky_flux_up'].values - ds['SW_clrsky_flux_dn'].values)
    flux_lw_cs = (ds['LW_clrsky_flux_up'].values - ds['LW_clrsky_flux_dn'].values)

    flux_sw = (ds['SW_clrsky_flux_up'].values - ds['SW_clrsky_flux_dn'].values)
    flux_lw = (ds['LW_flux_up'].values - ds['LW_flux_dn'].values)

    Q_rad_clrsky = (np.diff(flux_sw_cs,axis=2)/np.gradient(p,axis=2) + np.diff(flux_lw_cs,axis=2)/np.gradient(p,axis=2))*9.81/1000

    Q_rad = (np.diff(flux_sw,axis=2)/np.gradient(p,axis=2) + np.diff(flux_lw,axis=2)/np.gradient(p,axis=2))*9.81/1000
    F_rad_clrsky = tropical_average(flux_sw_cs) + tropical_average(flux_lw_cs)
    F_rad = tropical_average(flux_sw) + tropical_average(flux_lw) 
    #clear sky
    omega_dn = in_cloud_sum(ds['omega_where_qi_plus_qc_gt_0.00001'].values,count_ice)
  
    S = in_cloud_average(ds['DryStaticEnergy_pvert_derivative_where_qi_le_0.00001'].values,1-count_ice)

    Q = in_cloud_average(ds['rrtmgp_T_mid_tend_where_qi_plus_qc_le_0.00001'].values,1-count_ice)

    Q_dyn_clr = in_cloud_average(ds['homme_T_mid_tend_where_qi_plus_qc_le_0.00001'].values,1-count_ice)
    #cloudy sky
    div_ice = in_cloud_sum(ds['omega_pvert_derivative_where_qi_plus_qc_gt_0.00001'].values,count_ice)

    omega_up = in_cloud_sum(ds['omega_where_qi_plus_qc_gt_0.00001'].values,count_ice)

    #in cloud mixing ratios

    qi_in_cloud = ds['qi_where_qi_plus_qc_gt_0.00001'].values

    qc_in_cloud = ds['qc'].values/count_ice

    qc_in_cloud[np.isinf(qc_in_cloud)] = np.nan

    #in cloud sources
    vap_dep = (ds['qv2qi_vapdep_where_qi_plus_qc_gt_0.00001'].values)

    sublim = (ds['qi2qv_sublim_where_qi_plus_qc_gt_0.00001'].values)

    evap = (ds['shoc_evap_where_qi_plus_qc_gt_0.00001'].values)

    cond = (ds['shoc_cond_where_qi_plus_qc_gt_0.00001'].values)

    homme_qi_tend_in_cloud = ds['homme_qi_tend_where_qi_plus_qc_gt_0.00001'].values

    homme_qc_tend_in_cloud = ds['homme_qc_tend'].values/count_ice

    homme_qc_tend_in_cloud[np.isinf(homme_qc_tend_in_cloud)] = np.nan

    F_sed_a = ds['precip_ice_flux_above_where_qi_plus_qc_gt_0.00001'].values
    F_sed = ds['precip_ice_flux_below_where_qi_plus_qc_gt_0.00001'].values
    prec_liq = ds['precip_liq_flux'].values
    qr2qv_evap = ds_mass_flux['qr2qv_evap'].values

    dqi_sed = 1000*np.gradient((F_sed_a+F_sed)*0.5,axis=2)/(np.gradient(p_mean/9.81))

    dqr_sed = 1000*np.diff(prec_liq,axis=2)/(np.gradient(p_mean/9.81))

    source_sum = in_cloud_sum(cond,count_ice) + in_cloud_sum(homme_qc_tend_in_cloud,count_ice) + in_cloud_sum(homme_qi_tend_in_cloud,count_ice) + in_cloud_sum(vap_dep,count_ice) 
    sed = in_cloud_sum(dqi_sed,count_ice)
    PE = tropical_average(qr2qv_evap)
    P = tropical_average(dqr_sed)+in_cloud_sum(dqi_sed,count_ice)
    sinks = in_cloud_sum(evap,count_ice) + in_cloud_sum(sublim,count_ice) + P + PE
    CF = tropical_average(count_ice)
    tau = (in_cloud_sum(qi_in_cloud,count_ice)+in_cloud_sum(qc_in_cloud,count_ice))/source_sum
    delta = CF/(tau*((omega_up)/9.81)) #this is actually the equivalent of phi*deltal or CSC*deltal at the anvil level
    qa = in_cloud_average(qc_in_cloud,count_ice)+in_cloud_average(qi_in_cloud,count_ice)
    
    cond_sum = in_cloud_sum(cond,count_ice) 
    evap_sum = in_cloud_sum(evap,count_ice) 
    return T,Q,S,omega_dn,omega_up,CF,tau,delta,qa,source_sum,sed,div_ice,sinks,P,PE,cond_sum,evap_sum,F_rad_clrsky,F_rad,Q_dyn_clr

