    function filesizeformat(size)
{
    var KB = 1024;
    var MB = KB * 1024;
    var GB = MB * 1024;
    var TB = GB * 1024;
    var PB = TB * 1024;

    if(size < KB)
    {
        size /= 1;
        if(size - parseInt(size.toString()) != 0)
            size = size.toFixed(1);
        else
            size = size.toFixed(0);
        return size.toString() + " Bytes";
    }
    else if(size < MB)
    {
        size /= KB;
        if(size - parseInt(size.toString()) != 0)
            size = size.toFixed(1);
        else
            size = size.toFixed(0);
        return size.toString() + " KB";
    }
    else if(size < GB)
    {
        size /= MB;
        if(size - parseInt(size.toString()) != 0)
            size = size.toFixed(1);
        else
            size = size.toFixed(0);
        return size.toString() + " MB";
    }
    else if(size < TB)
    {
        size /= GB;
        if(size - parseInt(size.toString()) != 0)
            size = size.toFixed(1);
        else
            size = size.toFixed(0);
        return size.toString() + " GB";
    }
    else if(size < PB)
    {
        size /= TB;
        if(size - parseInt(size.toString()) != 0)
            size = size.toFixed(1);
        else
            size = size.toFixed(0);
        return size.toString() + " TB";
    }
    else
    {
        size /= PB;
        if(size - parseInt(size.toString()) != 0)
            size = size.toFixed(1);
        else
            size = size.toFixed(0);
        return size.toString() + " PB";
    }
}

function datarateformat(datarate)
{
    var KiB = 1024;
    var MiB = KiB * 1024;
    var GiB = MiB * 1024;

    if(datarate < KiB)
    {
        return datarate.toFixed(0).toString() + " B / s";
    }
    else if(datarate < MiB)
    {
        datarate /= KiB;
        return datarate.toFixed(0).toString() + " KiB / s";
    }
    else if(datarate < GiB)
    {
        datarate /= MiB;
        return datarate.toFixed(0).toString() + " MiB / s";
    }
    else
    {
        datarate /= GiB;
        return datarate.toFixed(0).toString() + " GiB / s";
    }
}

